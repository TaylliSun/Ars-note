# ── Ars-note Self-hosted Sync Server — Environment Variables ──
# Copy this file to .env and fill in values before running docker compose.
#   cp .env.example .env

# ── Sync Server ──

# API key for client authentication (required; use at least 32 random characters)
ARS_NOTE_SERVER_API_KEY=

# Public/self-hosted deployments should fail closed when the key is missing.
ARS_NOTE_REQUIRE_API_KEY=true

# LAN is the default. For an Internet-facing HTTPS reverse proxy, use
# docker-compose.public.yml, which switches this to "public" and fails closed.
ARS_NOTE_SECURITY_MODE=lan

# Public mode only trusts these browser origins. "null" is required by the
# packaged Electron client. Add a comma-separated HTTPS admin origin if needed.
ARS_NOTE_ALLOWED_ORIGINS=null

# Storage backend: "local" or "s3" (local is the simplest NAS setup)
ARS_NOTE_STORAGE_BACKEND=local

# Sync server port (host mapping)
ARSNOTE_PORT=8787

# ── S3 / MinIO Connection ──
# Server connects to MinIO internally via Docker network
ARS_NOTE_S3_ENDPOINT=http://minio:9000
ARS_NOTE_S3_REGION=us-east-1
ARS_NOTE_S3_BUCKET=ars-note-sync

# MinIO access credentials (must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
ARS_NOTE_S3_ACCESS_KEY_ID=
ARS_NOTE_S3_SECRET_ACCESS_KEY=

# Path-style URLs (required for MinIO)
ARS_NOTE_S3_FORCE_PATH_STYLE=true

# ── MinIO ──

# MinIO root credentials (set strong values for production)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MinIO port mappings (only change if you have port conflicts)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
